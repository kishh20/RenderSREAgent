# Target Render Application
APP_NAME=My Render Web Service
TARGET_URL=https://your-service-name.onrender.com/health
EXPECTED_KEYWORD=ok

# Render REST API v1 (Required for Self-Healing Container Restarts & Log Fetching)
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxxxx

# Gemini API (Required for AI Root-Cause Crash Triage; uses gemini-3.8-flash)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Bot Alerting (Primary Channel)
TELEGRAM_BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=987654321

# SMTP Email Alerting (Fallback Channel — Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=alerts-recipient@gmail.com
